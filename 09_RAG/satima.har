            "text": "{\"result\":{\"multiTenancy\":{\"isEnabled\":false,\"ignoreFeatureCheckForHostUsers\":false,\"sides\":{\"host\":2,\"tenant\":1}},\"session\":{\"userId\":289,\"tenantId\":1,\"impersonatorUserId\":null,\"impersonatorTenantId\":1,\"multiTenancySide\":1},\"localization\":{\"currentCulture\":{\"name\":\"fa\",\"displayName\":\"فارسی\"},\"languages\":[{\"name\":\"fa\",\"displayName\":\"فارسی\",\"icon\":\"famfamfam-flags ir\",\"isDefault\":true,\"isDisabled\":false,\"isRightToLeft\":true}],\"currentLanguage\":{\"name\":\"fa\",\"displayName\":\"فارسی\",\"icon\":\"famfamfam-flags ir\",\"isDefault\":true,\"isDisabled\":false,\"isRightToLeft\":true},\"sources\":[{\"name\":\"Abp\",\"type\":\"MultiTenantLocalizationSource\"},{\"name\":\"AbpWeb\",\"type\":\"MultiTenantLocalizationSource\"},{\"name\":\"AbpZero\",\"type\":\"MultiTenantLocalizationSource\"},{\"name\":\"Chain\",\"type\":\"MultiTenantLocalizationSource\"}],\"values\":{\"Abp\":{\"AllOfTheseFeaturesMustBeEnabled\":\"ویژگی های مورد نیاز فعال نیستند همه این ویژگی ها باید فعال شوند: {0}\",\"AllOfThesePermissionsMustBeGranted\":\"دسترسی مورد نیاز کاربر تعریف نشده است. تمام این حق دسترسی ها باید برای کاربر تعریف شود: {0}\",\"AtLeastOneOfTheseFeaturesMustBeEnabled\":\"ویژگی های مورد نیاز فعال نیستند حداقل یکی از این ویژگی ها باید فعال باشد: {0}\",\"AtLeastOneOfThesePermissionsMustBeGranted\":\"دسترسی مورد نیاز کاربر تعریف نشده است. حداقل یکی از این دسترسی ها باید برای کاربر تعیین شود : {0}\",\"CurrentUserDidNotLoginToTheApplication\":\"کاربر جاری اجازه ورود مجدد به سامانه را نداشته باشد.\",\"DefaultFromSenderDisplayName\":\"از نام پیش فرض به عنوان فرستنده استفاده شود.\",\"DefaultFromSenderEmailAddress\":\"از آدرس پست الکترونیک پیش فرض به عنوان فرستنده استفاده شود.\",\"DefaultLanguage\":\"زبان پیش فرض سامانه!\",\"DomainName\":\"نام دامنه\",\"FeatureIsNotEnabled\":\"ویژگیفعالنیست: {0}\",\"MainMenu\":\"منویاصلی\",\"Password\":\"کلمه عبور\",\"ReceiveNotifications\":\"دریافت اطلاعیه از طرف سامانه!\",\"SmtpHost\